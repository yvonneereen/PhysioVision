{
    "display_information": {
        "name": "Physio Assistant"
    },
    "features": {
        "bot_user": {
            "display_name": "Physio Assistant",
            "always_online": true
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "im:history",
                "app_mentions:read",
                "chat:write",
                "im:write"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "https://physiovision.onrender.com/api/slack/events/",
            "bot_events": [
                "app_mention",
                "message.im"
            ]
        },
        "interactivity": {
            "is_enabled": true,
            "request_url": "https://physiovision.onrender.com/api/slack/events/"
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "is_hosted": false,
        "token_rotation_enabled": false
    }
}
